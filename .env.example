# Configurações do Servidor
PORT=3000
NODE_ENV=development
ADMIN_PIN=4321

# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=kids9_secure_password
DB_NAME=kids9

# Provedor de Mensagens WhatsApp: 'free' (WAHA) ou 'official' (Meta Cloud API)
WHATSAPP_PROVIDER=free

# Configurações do Provedor Gratuito (WAHA) - Obrigatório apenas se WHATSAPP_PROVIDER=free
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION_NAME=default

# Configurações do Provedor Oficial (Meta Cloud API) - Obrigatório apenas se WHATSAPP_PROVIDER=official
META_WA_TOKEN=insira_seu_token_de_acesso_da_meta
META_WA_PHONE_NUMBER_ID=insira_seu_phone_number_id
META_WA_API_VERSION=v18.0

